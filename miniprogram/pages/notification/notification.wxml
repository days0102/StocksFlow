<!--notification.wxml-->
<view class="app-page {{appThemeClass}} {{appLanguageClass}}" style="{{appThemeVars}}">
<navigation-bar title="{{i18n.pages.notification}}" back="{{false}}" color="{{appTheme.navTextColor}}" background="{{appTheme.navBackgroundColor}}"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-content">

    <!-- ====== Info Banner ====== -->
    <view class="info-banner">
      <view class="banner-icon-wrap">
        <text class="banner-icon">🔔</text>
      </view>
      <view class="banner-body">
        <text class="banner-title">{{i18n.notification.bannerTitle}}</text>
        <text class="banner-desc">{{i18n.notification.bannerDesc}}</text>
      </view>
    </view>

    <!-- ====== Market Subscriptions ====== -->
    <van-cell-group title="{{i18n.notification.marketSubscriptions}}" border="{{false}}" custom-class="section-group">
      <view class="section-desc">{{subscriptionEnabled ? i18n.notification.subscriptionDesc : i18n.notification.disabledHint}}</view>

      <view
        class="subscription-item"
        wx:for="{{subscriptions}}"
        wx:key="marketId"
        data-index="{{index}}"
      >
        <view class="sub-info">
          <view class="sub-header">
            <text class="sub-name">{{item.marketName}}</text>
            <text class="sub-open-time">{{i18n.notification.openAt}} {{item.openTime}} CST</text>
          </view>
          <view
            class="sub-timing-row"
            bindtap="showTimingPicker"
            data-index="{{index}}"
          >
            <text class="sub-timing-label">{{i18n.notification.timing}}{{item.timingLabel}}</text>
            <van-icon name="arrow-down" size="10px" color="{{appTheme.textSecondaryColor}}" />
          </view>
        </view>
        <van-switch
          size="22px"
          checked="{{item.enabled}}"
          disabled="{{!subscriptionEnabled}}"
          active-color="{{appTheme.switchActiveColor}}"
          bind:change="onMarketToggle"
          data-index="{{index}}"
        />
      </view>

      <view class="authorize-row" wx:if="{{tmplIds.length > 0}}">
        <view class="authorize-btn" bindtap="onAuthorizeAll">
          <text>{{i18n.notification.authorizeAll}}</text>
        </view>
      </view>
    </van-cell-group>

    <!-- ====== Notification Messages ====== -->
    <van-cell-group title="{{i18n.notification.records}}" border="{{false}}" custom-class="section-group">
      <view class="section-desc">{{i18n.notification.recordsDesc}}</view>

      <block wx:if="{{notifyMessages.length > 0}}">
        <view
          class="message-item"
          wx:for="{{notifyMessages}}"
          wx:key="id"
          bindtap="onTapMessage"
          data-index="{{index}}"
        >
          <view class="msg-indicator {{item.read ? 'read' : ''}}"></view>
          <view class="msg-body">
            <view class="msg-header">
              <text class="msg-title">{{item.title}}</text>
              <van-tag type="{{item.read ? 'default' : 'primary'}}" size="mini" custom-class="msg-tag">
                {{item.marketName}}
              </van-tag>
            </view>
            <text class="msg-content">{{item.content}}</text>
            <text class="msg-time">{{item.date}} {{item.time}}</text>
          </view>
        </view>
      </block>

      <view class="empty-state" wx:else>
        <text class="empty-icon">📭</text>
        <text class="empty-text">{{i18n.notification.empty}}</text>
        <text class="empty-hint">{{i18n.notification.emptyHint}}</text>
      </view>
    </van-cell-group>

    <!-- ====== Footer ====== -->
    <view class="footer-note">
      <text>{{i18n.notification.footer}}</text>
    </view>

  </view>
</scroll-view>

<!-- ====== Timing Action Sheet ====== -->
<van-action-sheet
  custom-class="app-action-sheet {{appThemeClass}}"
  list-class="app-action-sheet-list"
  show="{{showTimingSheet}}"
  actions="{{timingOptions}}"
  cancel-text="{{i18n.common.cancel}}"
  bind:close="onTimingSheetClose"
  bind:cancel="onTimingSheetClose"
  bind:select="onTimingSelect"
/>
</view>
