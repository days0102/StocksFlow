<view class="app-page {{appThemeClass}} {{appLanguageClass}}" style="{{appThemeVars}}">
<navigation-bar title="{{i18n.pages.calendar}}" back="{{false}}" color="{{appTheme.navTextColor}}" background="{{appTheme.navBackgroundColor}}"></navigation-bar>

<view class="header-section">
    <view class="calendar-sheet">
      <view class="sheet-header">
        <view class="title-area">
          <text class="title">{{currentMarket.symbol}} {{i18n.market.tradingCalendar}}</text>
          <text class="subtitle">{{i18n.common.localTime}}</text>
        </view>
      </view>

      <view class="calendar-wrap">
        <van-calendar 
          class="custom-vant-calendar"
          poppable="{{ false }}"
          show-title="{{ false }}"
          show-subtitle="{{ true }}"
          show-confirm="{{ false }}"
          min-date="{{ minDate }}"
          max-date="{{ maxDate }}"
          formatter="{{ dayFormatter }}"
        />
      </view>

      <view class="sheet-legend">
        <view class="legend-item"><view class="dot status-open"></view>{{i18n.market.normalTrading}}</view>
        <view class="legend-item"><view class="dot status-closed"></view>{{i18n.market.weekendClosed}}</view>
        <view class="legend-item"><view class="dot status-holiday"></view>{{i18n.market.holidayClosed}}</view>
      </view>
    </view>
</view>
</view>
