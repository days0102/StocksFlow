<navigation-bar title="市场日历" back="{{false}}"></navigation-bar>

<view class="header-section">
    <view class="calendar-sheet">
      <view class="sheet-header">
        <view class="title-area">
          <text class="title">{{currentMarket.symbol}} 交易日历</text>
          <text class="subtitle">当地时间</text>
        </view>
      </view>

      <view class="calendar-wrap">
        <van-calendar 
          class="custom-vant-calendar"
          poppable="{{ false }}"
          show-title="{{ false }}"
          show-subtitle="{{ true }}"
          show-confirm="{{ false }}"
          min-date="{{ minDate }}"
          max-date="{{ maxDate }}"
          formatter="{{ dayFormatter }}"
        />
      </view>

      <view class="sheet-legend">
        <view class="legend-item"><view class="dot status-open"></view>正常交易</view>
        <view class="legend-item"><view class="dot status-closed"></view>周末休市</view>
        <view class="legend-item"><view class="dot status-holiday"></view>法定假日</view>
      </view>
    </view>
</view>