<!--index.wxml-->
<view class="app-page {{appThemeClass}} {{appLanguageClass}}" style="{{appThemeVars}}">
<navigation-bar title="{{i18n.pages.settings}}" back="{{false}}" color="{{appTheme.navTextColor}}" background="{{appTheme.navBackgroundColor}}"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-content">

    <!-- ====== Profile Card (login preserved) ====== -->
    <view class="profile-card">
      <!-- <view class="profile-bg"></view> -->
      <view class="profile-body">
        <block wx:if="{{canIUseNicknameComp && !hasUserInfo}}">
          <!-- Not logged in: avatar chooser + nickname input -->
          <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
            <image class="avatar" src="{{userInfo.avatarUrl}}"></image>
          </button>
          <view class="nickname-wrapper">
            <text class="nickname-label">{{i18n.settings.profileNickname}}</text>
            <input type="nickname" class="nickname-input" placeholder="{{i18n.settings.nicknamePlaceholder}}" bind:change="onInputChange" />
          </view>
        </block>
        <block wx:elif="{{!hasUserInfo}}">
          <button wx:if="{{canIUseGetUserProfile}}" class="login-btn" bindtap="getUserProfile">{{i18n.settings.loginButton}}</button>
          <view wx:else class="compat-tip">{{i18n.settings.compatTip}}</view>
        </block>
        <block wx:else>
          <!-- Logged in: show avatar & name -->
          <image bindtap="bindViewTap" class="userinfo-avatar" src="{{userInfo.avatarUrl}}" mode="cover"></image>
          <text class="userinfo-nickname">{{userInfo.nickName}}</text>
        </block>
      </view>
    </view>

    <!-- ====== Appearance ====== -->
    <van-cell-group title="{{i18n.settings.appearance}}" border="{{false}}" custom-class="settings-group">
      <van-cell
        title="{{i18n.settings.theme}}"
        is-link
        value="{{themeLabel}}"
        bindtap="showThemeSheet"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="bulb-o" class="cell-icon" color="{{appTheme.primaryColor}}" />
      </van-cell>
      <van-cell
        title="{{i18n.settings.language}}"
        is-link
        value="{{languageLabel}}"
        bindtap="showLanguageSheet"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="font-o" class="cell-icon" color="{{appTheme.primaryColor}}" />
      </van-cell>
    </van-cell-group>

    <!-- ====== Market Preferences ====== -->
    <van-cell-group title="{{i18n.settings.marketPreference}}" border="{{false}}" custom-class="settings-group">
      <van-cell
        title="{{i18n.settings.defaultMarket}}"
        is-link
        value="{{defaultMarketLabel}}"
        bindtap="showMarketSheet"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="chart-trending-o" class="cell-icon" color="#00B87A" />
      </van-cell>
    </van-cell-group>

    <!-- ====== Notifications ====== -->
    <van-cell-group title="{{i18n.settings.notifications}}" border="{{false}}" custom-class="settings-group">
      <van-cell
        title="{{i18n.settings.subscription}}"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="bell" class="cell-icon" color="#FA8C16" />
        <van-switch
          slot="right-icon"
          size="22px"
          checked="{{subscriptionEnabled}}"
          active-color="{{appTheme.switchActiveColor}}"
          bind:change="onSubscriptionToggle"
        />
      </van-cell>
      <van-cell
        title="{{i18n.settings.notifyFrequency}}"
        is-link
        value="{{notifyFreqLabel}}"
        bindtap="showNotifySheet"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="clock-o" class="cell-icon" color="#722ED1" />
      </van-cell>
      <van-cell
        title="{{i18n.settings.manageSubscriptions}}"
        is-link
        value="{{activeSubLabel}}"
        bindtap="goToNotifications"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="enlarge" class="cell-icon" color="#13C2C2" />
      </van-cell>
    </van-cell-group>

    <!-- ====== About ====== -->
    <van-cell-group title="{{i18n.settings.about}}" border="{{false}}" custom-class="settings-group">
      <van-cell
        title="{{i18n.settings.logs}}"
        is-link
        bindtap="goToLogs"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="notes-o" class="cell-icon" color="#FA541C" />
      </van-cell>
      <van-cell
        title="{{i18n.settings.aboutUs}}"
        is-link
        bindtap="goToAbout"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="info-o" class="cell-icon" color="{{appTheme.primaryColor}}" />
      </van-cell>
      <van-cell
        title="{{i18n.settings.feedback}}"
        is-link
        bindtap="goToFeedback"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="comment-o" class="cell-icon" color="#13C2C2" />
      </van-cell>
      <van-cell
        title="{{i18n.settings.currentVersion}}"
        value="{{appVersion}}"
        custom-class="settings-cell"
      >
        <van-icon slot="icon" name="apps-o" class="cell-icon" color="#8C92A4" />
      </van-cell>
    </van-cell-group>

    <!-- ====== Logout ====== -->
    <view wx:if="{{hasUserInfo}}" class="logout-section">
      <view class="logout-btn" bindtap="onLogout">{{i18n.settings.logout}}</view>
    </view>

    <!-- ====== ActionSheets ====== -->
    <van-action-sheet
      custom-class="app-action-sheet {{appThemeClass}}"
      list-class="app-action-sheet-list"
      show="{{showThemeSheet}}"
      actions="{{themeActions}}"
      cancel-text="{{i18n.common.cancel}}"
      bind:close="onThemeSheetClose"
      bind:cancel="onThemeSheetClose"
      bind:select="onThemeSelect"
    />

    <van-action-sheet
      custom-class="app-action-sheet {{appThemeClass}}"
      list-class="app-action-sheet-list"
      show="{{showMarketSheet}}"
      actions="{{marketActions}}"
      cancel-text="{{i18n.common.cancel}}"
      bind:close="onMarketSheetClose"
      bind:cancel="onMarketSheetClose"
      bind:select="onMarketSelect"
    />

    <van-action-sheet
      custom-class="app-action-sheet {{appThemeClass}}"
      list-class="app-action-sheet-list"
      show="{{showNotifySheet}}"
      actions="{{notifyActions}}"
      cancel-text="{{i18n.common.cancel}}"
      bind:close="onNotifySheetClose"
      bind:cancel="onNotifySheetClose"
      bind:select="onNotifyFreqSelect"
    />

    <van-action-sheet
      custom-class="app-action-sheet {{appThemeClass}}"
      list-class="app-action-sheet-list"
      show="{{showLanguageSheet}}"
      actions="{{languageActions}}"
      cancel-text="{{i18n.common.cancel}}"
      bind:close="onLanguageSheetClose"
      bind:cancel="onLanguageSheetClose"
      bind:select="onLanguageSelect"
    />

  </view>
</scroll-view>
</view>
