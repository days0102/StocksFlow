<!--feedback.wxml-->
<view class="app-page {{appThemeClass}} {{appLanguageClass}}" style="{{appThemeVars}}">
<navigation-bar title="{{i18n.pages.feedback}}" back="{{true}}" color="{{appTheme.navTextColor}}" background="{{appTheme.navBackgroundColor}}"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="feedback-page">

    <!-- Category selector -->
    <view class="section-title">{{i18n.feedback.type}}</view>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="category-chip {{selectedCategory === item.value ? 'active' : ''}}"
        bindtap="onSelectCategory"
        data-value="{{item.value}}"
      >
        <text class="chip-icon">{{item.icon}}</text>
        <text class="chip-label">{{item.label}}</text>
      </view>
    </view>

    <!-- Feedback content -->
    <view class="section-title">{{i18n.feedback.detail}}</view>
    <view class="textarea-wrap">
      <textarea
        class="feedback-textarea"
        placeholder="{{i18n.feedback.detailPlaceholder}}"
        maxlength="500"
        bindinput="onInput"
        value="{{content}}"
      />
      <text class="char-count">{{content.length}}/500</text>
    </view>

    <!-- Contact -->
    <view class="section-title">{{i18n.feedback.contact}}</view>
    <view class="contact-input-wrap">
      <input
        class="contact-input"
        placeholder="{{i18n.feedback.contactPlaceholder}}"
        bindinput="onContactInput"
        value="{{contact}}"
      />
    </view>

    <!-- Submit -->
    <view class="submit-section">
      <van-button
        type="primary"
        block
        round
        color="{{appTheme.buttonColor}}"
        custom-class="submit-btn"
        disabled="{{!canSubmit}}"
        bindtap="onSubmit"
      >
        {{i18n.feedback.submit}}
      </van-button>
    </view>

    <!-- Tip -->
    <view class="tip-section">
      <text class="tip-text">💡 {{i18n.feedback.tip}}</text>
    </view>

  </view>
</scroll-view>
</view>
