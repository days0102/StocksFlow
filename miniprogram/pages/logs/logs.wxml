<!--logs.wxml-->
<navigation-bar title="通知设置" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="container">
  <view class="section-title">消息订阅设置</view>
  <view class="section-desc">选择您希望接收的通知类型</view>
  
  <view class="notification-list">
    <view class="notification-item" wx:for="{{notificationTypes}}" wx:key="type">
      <view class="item-content">
        <view class="item-icon">{{item.icon}}</view>
        <view class="item-info">
          <view class="item-title">{{item.title}}</view>
          <view class="item-desc">{{item.description}}</view>
        </view>
      </view>
      <switch 
        checked="{{item.subscribed}}" 
        bindchange="onToggleNotification"
        data-type="{{item.type}}"
        color="#3f72af"
      />
    </view>
  </view>

  <view class="section-title" style="margin-top: 40rpx;">通知频率</view>
  <radio-group class="frequency-group" bindchange="onFrequencyChange">
    <label class="frequency-item" wx:for="{{frequencyOptions}}" wx:key="value">
      <radio value="{{item.value}}" checked="{{item.value === selectedFrequency}}" color="#3f72af"/>
      <text>{{item.label}}</text>
    </label>
  </radio-group>

  <view class="save-btn" bindtap="onSaveSettings">
    保存设置
  </view>
</view>
